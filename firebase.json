{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "ios/**",
      "dist/**",
      "test/**",
      "functions/**",
      "scripts/**",
      "**/*.apk",
      "**/*.bat",
      "**/*.exe"
    ]
  }
}
