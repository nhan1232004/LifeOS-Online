rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(project) { return signedIn() && project.data.ownerUid == request.auth.uid; }
    function isMember(project) { 
      return signedIn() && (
        (project.data.memberUids != null && request.auth.uid in project.data.memberUids) ||
        (project.data.members != null && request.auth.token.email != null && (request.auth.token.email in project.data.members || request.auth.token.email.lower() in project.data.members)) ||
        (project.data.ownerUid != null && project.data.ownerUid == request.auth.uid)
      );
    }
    function project(projectId) { return get(/databases/$(database)/documents/shared_projects/$(projectId)); }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /shared_projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(resource);
      allow update: if signedIn() && (
        // Case 1: Owner updates project (ownerUid cannot be changed)
        (isOwner(resource) && request.resource.data.ownerUid == resource.data.ownerUid) ||
        // Case 2: Invited member joins and registers their uid into memberUids
        (
          request.auth.token.email != null &&
          (request.auth.token.email in resource.data.members || request.auth.token.email.lower() in resource.data.members) &&
          (resource.data.memberUids == null || !(request.auth.uid in resource.data.memberUids)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.auth.uid in request.resource.data.memberUids &&
          (resource.data.memberUids == null || request.resource.data.memberUids.hasAll(resource.data.memberUids))
        ) ||
        // Case 3: Regular member updates project progress/details (cannot touch ownerUid, members, or memberUids)
        (
          isMember(resource) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'members', 'memberUids'])
        )
      );
      allow delete: if isOwner(resource);

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/shared_projects/$(projectId)));
        allow create: if isMember(get(/databases/$(database)/documents/shared_projects/$(projectId)))
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /shared_tasks/{taskId} {
      allow read: if signedIn() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isMember(project(resource.data.projId))
      );
      allow create: if signedIn() && (
        (request.resource.data.memberUids != null && request.auth.uid in request.resource.data.memberUids) ||
        isMember(project(request.resource.data.projId))
      );
      allow update: if signedIn() && (
        request.resource.data.projId == resource.data.projId &&
        (
          (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
          isMember(project(resource.data.projId))
        )
      );
      allow delete: if signedIn() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isMember(project(resource.data.projId))
      );
    }

    match /shared_vocab_decks/{deckId} {
      allow read: if signedIn() && (
        resource.data.mode == 'public' ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.allowedEmails != null && request.auth.token.email != null && request.auth.token.email in resource.data.allowedEmails) ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clones', 'memberUids'])
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
