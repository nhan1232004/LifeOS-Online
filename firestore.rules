rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(project) { return signedIn() && project.data.ownerUid == request.auth.uid; }
    function isMember(project) { return signedIn() && request.auth.uid in project.data.memberUids; }
    function project(projectId) { return get(/databases/$(database)/documents/shared_projects/$(projectId)); }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /shared_projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow read: if isMember(resource);
      allow update: if isOwner(resource)
        || (isMember(resource)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids);
      allow delete: if isOwner(resource);

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/shared_projects/$(projectId)));
        allow create: if isMember(get(/databases/$(database)/documents/shared_projects/$(projectId)))
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /shared_tasks/{taskId} {
      allow read: if signedIn() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isMember(project(resource.data.projId))
      );
      allow create: if signedIn() && (
        (request.resource.data.memberUids != null && request.auth.uid in request.resource.data.memberUids) ||
        isMember(project(request.resource.data.projId))
      );
      allow update: if signedIn() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isMember(project(resource.data.projId))
      );
      allow delete: if signedIn() && (
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        isMember(project(resource.data.projId))
      );
    }

    match /shared_vocab_decks/{deckId} {
      allow read: if signedIn() && (
        resource.data.mode == 'public' ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.allowedEmails != null && request.auth.token.email != null && request.auth.token.email in resource.data.allowedEmails) ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clones', 'memberUids'])
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
